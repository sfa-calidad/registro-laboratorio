generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Ingreso {
  id            Int       @id @default(autoincrement())
  hrRemito      String
  fecha         DateTime
  origen        String
  producto1     String
  producto2     String?
  observacion   String?
  precinto      String?
  operador      String?
  fechaAnalisis DateTime?
  createdAt     DateTime  @default(now())
  rotulos       Rotulo[]
}

model Despacho {
  id            Int      @id @default(autoincrement())
  hrContrato    String
  fecha         DateTime
  destino       String
  producto      String
  deposito      String?
  idTransporte  String
  observacion   String?
  precintSFA    String?
  precintAduana String?
  operador      String?
  createdAt     DateTime @default(now())
  rotulos       Rotulo[]
}

model Configuracion {
  id             Int    @id @default(autoincrement())
  clave          String @unique
  valor          String
}

model Rotulo {
  id         Int       @id @default(autoincrement())
  tipo       String
  data       String
  ingresoId  Int?
  despachoId Int?
  ingreso    Ingreso?  @relation(fields: [ingresoId], references: [id])
  despacho   Despacho? @relation(fields: [despachoId], references: [id])
  createdAt  DateTime  @default(now())
}

model Producto {
  id     Int    @id @default(autoincrement())
  nombre String @unique
}

model Contacto {
  id     Int    @id @default(autoincrement())
  nombre String
}

model Analista {
  id        Int      @id @default(autoincrement())
  nombre    String
  apellido  String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  tareasF1  Tarea[]  @relation("firma1")
  tareasF2  Tarea[]  @relation("firma2")

  @@unique([nombre, apellido])
}

model ColumnaKanban {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  orden  Int
  tareas Tarea[]
}

model Tarea {
  id               Int           @id @default(autoincrement())
  titulo           String
  descripcion      String?
  columnaId        Int
  columna          ColumnaKanban @relation(fields: [columnaId], references: [id])
  analistaId1      Int?
  analistaId2      Int?
  firma1           Analista?     @relation("firma1", fields: [analistaId1], references: [id])
  firma2           Analista?     @relation("firma2", fields: [analistaId2], references: [id])
  prioridad        String?
  fechaVencimiento DateTime?
  creadoPor        String
  completadaAt     DateTime?
  createdAt        DateTime      @default(now())
  etiquetas        String?
  notas            String?
  archivadaAt      DateTime?
  checklist        String?
  mostrarChecklist Boolean       @default(false)
}
