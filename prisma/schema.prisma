generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./laboratorio.db"
}


model Ingreso {
  id            Int       @id @default(autoincrement())
  hrRemito      String
  fecha         DateTime
  origen        String
  producto1     String
  producto2     String?
  observacion   String?
  precinto      String?
  operador      String?
  fechaAnalisis DateTime?
  createdAt     DateTime  @default(now())
  rotulos       Rotulo[]
}

model Despacho {
  id            Int      @id @default(autoincrement())
  hrContrato    String
  fecha         DateTime
  destino       String
  producto      String
  deposito      String?
  idTransporte  String
  observacion   String?
  precintSFA    String?
  precintAduana String?
  operador      String?
  createdAt     DateTime @default(now())
  rotulos       Rotulo[]
}

model Configuracion {
  id             Int    @id @default(autoincrement())
  clave          String @unique
  valor          String
}

model Rotulo {
  id         Int       @id @default(autoincrement())
  tipo       String
  data       String
  ingresoId  Int?
  despachoId Int?
  ingreso    Ingreso?  @relation(fields: [ingresoId], references: [id])
  despacho   Despacho? @relation(fields: [despachoId], references: [id])
  createdAt  DateTime  @default(now())
}

model Producto {
  id     Int    @id @default(autoincrement())
  nombre String @unique
}
