generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ingreso {
  id            Int                    @id @default(autoincrement())
  hrRemito      String
  fecha         DateTime
  origen        String
  producto1     String
  producto2     String?
  observacion   String?
  precinto      String?
  operador      String?
  fechaAnalisis DateTime?
  createdAt     DateTime               @default(now())
  rotulos       Rotulo[]
  analisis      AnalisisMateriaPrima[]

  @@index([fecha, id])
}

model Despacho {
  id            Int      @id @default(autoincrement())
  hrContrato    String
  fecha         DateTime
  destino       String
  producto      String
  deposito      String?
  idTransporte  String
  observacion   String?
  precintSFA    String?
  precintAduana String?
  operador      String?
  createdAt     DateTime @default(now())
  rotulos       Rotulo[]

  @@index([fecha, id])
}

model Configuracion {
  id    Int    @id @default(autoincrement())
  clave String @unique
  valor String
}

model Rotulo {
  id         Int       @id @default(autoincrement())
  tipo       String
  data       String
  ingresoId  Int?
  despachoId Int?
  ingreso    Ingreso?  @relation(fields: [ingresoId], references: [id])
  despacho   Despacho? @relation(fields: [despachoId], references: [id])
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([ingresoId])
  @@index([despachoId])
}

model Producto {
  id     Int    @id @default(autoincrement())
  nombre String @unique
}

model Contacto {
  id     Int    @id @default(autoincrement())
  nombre String
}

model Analista {
  id        Int      @id @default(autoincrement())
  nombre    String
  apellido  String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  tareasF1  Tarea[]  @relation("firma1")
  tareasF2  Tarea[]  @relation("firma2")

  @@unique([nombre, apellido])
}

model ColumnaKanban {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  orden  Int
  tareas Tarea[]
}

model Tarea {
  id               Int           @id @default(autoincrement())
  titulo           String
  descripcion      String?
  columnaId        Int
  columna          ColumnaKanban @relation(fields: [columnaId], references: [id])
  analistaId1      Int?
  analistaId2      Int?
  firma1           Analista?     @relation("firma1", fields: [analistaId1], references: [id])
  firma2           Analista?     @relation("firma2", fields: [analistaId2], references: [id])
  prioridad        String?
  fechaVencimiento DateTime?
  creadoPor        String
  completadaAt     DateTime?
  orden            Int           @default(0)
  createdAt        DateTime      @default(now())
  etiquetas        String?
  notas            String?
  archivadaAt      DateTime?
  checklist        String?
  mostrarChecklist Boolean       @default(false)

  @@index([columnaId, orden])
  @@index([archivadaAt])
  @@index([completadaAt])
}

model NotaTablero {
  id        Int      @id @default(autoincrement())
  titulo    String?
  texto     String?
  autor     String
  createdAt DateTime @default(now())
}

// --- Análisis de tanques y muestras a laboratorio ---------------------------

// Catálogo único de ensayos: sirve para análisis de tanques y para muestras.
// El método es parte de la identidad del ensayo: "Humedad · Termobalanza" y
// "Humedad · Karl Fischer" miden cosas distintas y nunca se fusionan.
model Parametro {
  id          Int     @id @default(autoincrement())
  nombre      String
  metodo      String? // "Termobalanza", "Karl Fischer"
  abreviatura String? // "Hum. TB", "Hum. KF" — encabezados de tabla
  unidad      String? // "%", "ppm", "g/cm³"
  decimales   Int     @default(2)
  orden       Int     @default(0)
  activo      Boolean @default(true)

  resultadosTanque       ResultadoTanque[]
  resultadosMateriaPrima ResultadoMateriaPrima[]
  perfiles               PerfilProducto[]
  especificaciones       Especificacion[]
  muestraEnsayos         MuestraEnsayo[]

  @@unique([nombre, metodo])
}

// Qué parámetros se muestran por defecto según el producto.
model PerfilProducto {
  id          Int       @id @default(autoincrement())
  producto    String
  parametroId Int
  parametro   Parametro @relation(fields: [parametroId], references: [id])
  orden       Int       @default(0)
  // El mismo producto se analiza distinto según de dónde venga la muestra: el
  // camión que entra lleva más ensayos que el control de tanque. Sin esto,
  // sumar los del camión alargaría el formulario de tanques.
  contexto    String    @default("TANQUE") // TANQUE | MATERIA_PRIMA

  @@unique([producto, parametroId, contexto])
}

// Rangos para marcar en rojo lo que se va de spec.
model Especificacion {
  id          Int       @id @default(autoincrement())
  producto    String
  parametroId Int
  parametro   Parametro @relation(fields: [parametroId], references: [id])
  min         Float?
  max         Float?

  @@unique([producto, parametroId])
}

model AnalisisTanque {
  id                  Int      @id @default(autoincrement())
  fecha               DateTime
  producto            String
  tanques             String // admite varios: "26 + 27", "114/118/119"
  alturaM             Float?
  // referencia y conjuntoHaciaArriba van separados a propósito: la referencia
  // (AF/DS/AC) dice desde dónde se mide la altura; el HA dice que la muestra
  // es un compuesto desde esa altura hacia arriba. Una muestra puntual y un
  // conjunto no son lo mismo, y en la planilla vieja quedaban mezclados.
  referencia          String? // AF | DS | AC | null
  conjuntoHaciaArriba Boolean  @default(false)
  analista            String?
  comentario          String?
  createdAt           DateTime @default(now())

  resultados ResultadoTanque[]

  @@index([fecha, id])
}

model ResultadoTanque {
  id          Int            @id @default(autoincrement())
  analisisId  Int
  analisis    AnalisisTanque @relation(fields: [analisisId], references: [id], onDelete: Cascade)
  parametroId Int
  parametro   Parametro      @relation(fields: [parametroId], references: [id])
  valor       Float?
  valorTexto  String? // para lo que no es numérico ("18 °C", "7 %")

  @@unique([analisisId, parametroId])
}

model Laboratorio {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  esExterno   Boolean @default(true)
  delExterior Boolean @default(false) // habilita el campo AWB
  activo      Boolean @default(true)
}

model LugarMuestreo {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  activo Boolean @default(true)
}

// Registro con el que el laboratorio identifica y sigue cualquier muestra que
// entra, salga o no a un laboratorio externo. Sin relación con AnalisisTanque:
// solo comparten el catálogo Parametro.
model Muestra {
  id                   Int       @id @default(autoincrement())
  numero               String    @unique // "26222", serie por año — etiqueta física del envase
  fecha                DateTime
  producto             String
  detalle              String?
  tipoOrigen           String? // Tanque | Camión | Buque | Isotanque | Bidón | N/A
  identificacionOrigen String?
  lugarMuestreo        String?
  contacto             String? // cliente / proveedor
  solicitadoPor        String?
  remito               String?
  envase               String? // "bidón 5 L"
  laboratorio          String?
  estado               String    @default("IDENTIFICADA")
  // IDENTIFICADA | EN_ANALISIS | ENVIADA | CON_RESULTADO | ANULADA
  fechaEnvio           DateTime?
  awb                  String?
  protocolo            String?
  fechaResultado       DateTime?
  resultado            String?
  adjuntoUrl           String?
  observacion          String?
  cargadoPor           String?
  createdAt            DateTime  @default(now())

  ensayos MuestraEnsayo[]

  @@index([fecha, id])
  @@index([estado])
}

model MuestraEnsayo {
  id          Int        @id @default(autoincrement())
  muestraId   Int
  muestra     Muestra    @relation(fields: [muestraId], references: [id], onDelete: Cascade)
  parametroId Int?
  parametro   Parametro? @relation(fields: [parametroId], references: [id])
  libre       String? // ensayo que no está en el catálogo

  @@index([muestraId])
}

// --- Análisis de materia prima al ingreso -----------------------------------

// El análisis del camión que entra a planta. Cuelga del Ingreso ya cargado, así
// que no repite origen, remito ni producto: los toma de ahí. Uno por ingreso,
// como en la planilla de Excel, donde un camión con varias cisternas es un solo
// bloque de resultados.
model AnalisisMateriaPrima {
  id          Int      @id @default(autoincrement())
  // Un análisis por producto del ingreso: un camión de borra con sobrenadante
  // de aceite se carga con producto1 y producto2, y cada uno se informa aparte.
  ingresoId   Int
  ingreso     Ingreso  @relation(fields: [ingresoId], references: [id], onDelete: Cascade)
  fecha       DateTime // fecha del análisis, no la del ingreso
  // El producto se copia del ingreso al analizar: si después se corrige el
  // ingreso, el informe ya emitido sigue diciendo lo que se analizó.
  producto    String
  cisternas   String?
  ordenCompra String?
  analista    String?
  comentario  String?
  createdAt   DateTime @default(now())

  resultados ResultadoMateriaPrima[]

  @@unique([ingresoId, producto])
  @@index([fecha, id])
  @@index([ingresoId])
}

model ResultadoMateriaPrima {
  id          Int                  @id @default(autoincrement())
  analisisId  Int
  analisis    AnalisisMateriaPrima @relation(fields: [analisisId], references: [id], onDelete: Cascade)
  parametroId Int
  parametro   Parametro            @relation(fields: [parametroId], references: [id])
  valor       Float?
  valorTexto  String? // para lo que no es numérico ("OK", "18 °C")
  // El límite se escribe al cargar el análisis, no sale del catálogo: cada
  // camión trae el suyo en la planilla de coordinación de esa orden de compra.
  // Se guarda con el resultado para que el informe reabierto muestre el que se
  // usó ese día, aunque después cambien las condiciones de compra.
  specMin     Float?
  specMax     Float?

  @@unique([analisisId, parametroId])
  @@index([analisisId])
}

// --- Inventario de insumos --------------------------------------------------
// Reemplaza las dos planillas de Excel (reactivos y material de vidrio). La
// diferencia de fondo con la planilla: el stock no es un número que se pisa,
// es el saldo de un registro de movimientos. Quién, cuándo y por qué quedan.

// Dónde se guarda. Catálogo y no texto libre: en la planilla los ~16 lugares
// reales estaban escritos de 19 formas ("Heladera" y "heladera", "Puerta " sin
// número, "Pañol/Labo  - Armario" con doble espacio).
model UbicacionInsumo {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  orden  Int     @default(0)
  activo Boolean @default(true)
}

// Sustancia controlada por RENPRE/SEDRONAR. Es una entidad propia y no una
// marca sobre el insumo porque la relación no es uno a uno: "Metanol" se
// declara una sola vez aunque en el laboratorio haya un frasco P.A. y otro
// grado HPLC, y el NaOH 50% a granel (2435 L) se declara sin ser un insumo de
// laboratorio.
model SustanciaControlada {
  id      Int      @id @default(autoincrement())
  nombre  String   @unique
  gtin    String   @unique
  unidad  String // "L" | "kg" — la unidad en la que se declara
  activo  Boolean  @default(true)
  insumos Insumo[]
}

model Insumo {
  id                 Int                  @id @default(autoincrement())
  nombre             String
  categoria          String // REACTIVO | VIDRIO
  // Cómo viene el envase, tal como se lee ("1 L", "250 g"). Es cosmética: la
  // que entra en las cuentas es contenidoPorEnvase. No es anulable porque
  // forma parte del único, y en Postgres dos NULL nunca chocan entre sí: con
  // una columna anulable se podrían cargar dos "Acetona" sin presentación.
  presentacion       String               @default("")
  ubicacion          String?
  // Saldo en envases. NUNCA se escribe directo: solo lo mueve la API de
  // movimientos, que en el mismo paso deja el asiento que lo explica.
  stock              Float                @default(0)
  stockMinimo        Float?
  // Hay ítems que no se cuentan en el laboratorio: se piden a pañol (iban con
  // "-" en la planilla) o nunca se contaron (celda vacía). Excel no distinguía
  // ninguno de los dos casos de un cero. No avisan de faltante hasta que
  // alguien los cuenta por primera vez.
  seControla         Boolean              @default(true)
  // Cuánto hay en un envase, en la unidad de la sustancia. Solo se usa para la
  // declaración de precursores: 5 envases de "(x 500ml)" de una sustancia que
  // se declara en litros son 5 × 0,5 = 2,5 L.
  contenidoPorEnvase Float?
  // "L" | "kg": en qué unidad está expresado el contenido. Va aparte para poder
  // rechazar el enlace de un insumo medido en kg a una sustancia que se declara
  // en litros — sin densidad, esa suma no existe.
  unidadContenido    String?
  sustanciaId        Int?
  sustancia          SustanciaControlada? @relation(fields: [sustanciaId], references: [id])
  observacion        String?
  // Cuándo se contó por última vez, aunque no haya dado diferencia: "lo
  // contamos y estaba bien" también es información, y un ajuste no la deja.
  ultimoRecuento     DateTime?
  activo             Boolean              @default(true)
  createdAt          DateTime             @default(now())
  movimientos        MovimientoInsumo[]

  @@unique([nombre, presentacion])
  @@index([categoria, nombre])
}

model MovimientoInsumo {
  id          Int      @id @default(autoincrement())
  insumoId    Int
  insumo      Insumo   @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  tipo        String // ENTRADA | CONSUMO | BAJA | AJUSTE
  // Siempre positiva; el signo lo pone el tipo. En un AJUSTE es lo contado.
  cantidad    Float
  // El saldo antes y después quedan grabados en el asiento: así el historial se
  // lee sin recalcular, y la declaración de precursores puede reconstruir el
  // stock de cualquier fecha sin depender del orden en que se cargó cada cosa.
  stockPrevio Float
  stockNuevo  Float
  motivo      String?
  analista    String?
  fecha       DateTime // fecha-calendario: cuándo pasó, no cuándo se cargó
  createdAt   DateTime @default(now())

  @@index([insumoId, id])
  @@index([fecha, id])
}
